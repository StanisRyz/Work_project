__pycache__/
*.py[cod]
*$py.class

.venv/
venv/
env/
ENV/

.env
.env.*
!.env.example

db.sqlite3
db.sqlite3.bak
*.sqlite3.bak
db.sqlite3.backup*
sqlite-backups/

# Migration bundles and transfer reports contain real working data
# (users, acts, attachments) and must never be committed.
migration-bundle/
migration-bundles/
*-migration-bundle/
verification-report.json
migration-report*.json

# Rehearsal artefacts: source copies, the target media of a rehearsal,
# orchestration temporaries and both report formats. The documentation
# (docs/postgresql_rehearsal.md) and the orchestrator itself
# (scripts/run_postgresql_rehearsal.py) stay in Git.
transfer/
transfer-*/
rehearsal/
rehearsal-*/
db-copy*.sqlite3
media-copy/
*-media-copy/
target-media/
*-target-media/
rehearsal-report*.json
rehearsal-report*.md
rehearsal-*.json
rehearsal-*.md
!docs/postgresql_rehearsal.md
!scripts/run_postgresql_rehearsal.py

# Local performance artefacts: profiling reports, EXPLAIN output, load-smoke
# summaries, pg_stat_activity snapshots and any throwaway performance database.
# Only the safe aggregate figures in docs/realtime_performance.md are committed.
perf-report*.json
perf*.sqlite3
explain-*.txt
smoke-report*.json
sse-connections*.json
!docs/realtime_performance.md

.idea/
.vscode/

media/
staticfiles/

.pytest_cache/
.coverage
htmlcov/

var/
