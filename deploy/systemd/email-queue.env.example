# Copy to /etc/quality-ecosystem/email-queue.env, restrict it to mode 600,
# and replace every example value. Do not commit the deployed file.
PROJECT_DIR=/srv/quality-ecosystem
PYTHON_BIN=/srv/quality-ecosystem/.venv/bin/python
EMAIL_NOTIFICATION_BATCH_SIZE=100

EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
APP_BASE_URL=https://quality.example.invalid
DEFAULT_FROM_EMAIL=quality@example.invalid
EMAIL_HOST=smtp.example.invalid
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
EMAIL_NOTIFICATION_MAX_ATTEMPTS=3
EMAIL_NOTIFICATION_RETRY_DELAY_SECONDS=300
EMAIL_NOTIFICATION_PROCESSING_TIMEOUT_SECONDS=900

