# Example environment file. Copy to .env for local overrides if needed —
# .env is gitignored and NOT loaded automatically by the project.
#
# DATABASE_ENGINE selects the database backend. "sqlite" is the default and
# requires no other variables below. See docs/postgresql_preparation.md.

DATABASE_ENGINE=sqlite

# Used only when DATABASE_ENGINE=postgresql. DB_NAME, DB_USER, and
# DB_PASSWORD are required in that mode; there is no fallback to SQLite.
DB_NAME=quality_ecosystem
DB_USER=quality_ecosystem
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=0
DB_CONN_HEALTH_CHECKS=false
