# Example environment file. Copy to .env for local reference if needed — but
# copying it is not enough by itself: .env is gitignored and this project does
# NOT read .env files automatically (no python-dotenv/django-environ). The
# variables below only take effect once your shell, IDE run configuration,
# process manager, or another external mechanism actually exports them into
# the process environment before `manage.py` runs.
#
# Every value here is a safe demonstration placeholder. Real secrets, real
# hostnames and real addresses must never be committed to this file.
#
# --------------------------------------------------------------------------
# Environment mode
# --------------------------------------------------------------------------
# development (default) | test | production. An unknown value is refused at
# startup. See docs/deployment_preparation.md.
APP_ENV=development

# Required in production and read only from the environment. The development
# fallback committed in settings.py is public by definition and is rejected in
# production, as is any value shorter than 50 characters or an obvious
# placeholder. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# SECRET_KEY=

# Must be false in production; the process refuses to start otherwise.
DEBUG=true

# Comma-separated. Must be non-empty in production, and "*" is rejected there.
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated absolute origins. Required in production, https:// only.
# CSRF_TRUSTED_ORIGINS=https://quality.example.internal

# Public root of the application; notification email links are built from it.
# Must be an absolute https:// URL in production.
APP_BASE_URL=http://127.0.0.1:8000

# --------------------------------------------------------------------------
# Security. Defaults are already safe in production; these are the overrides.
# --------------------------------------------------------------------------
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SESSION_COOKIE_HTTPONLY=true
# SESSION_COOKIE_SAMESITE=Lax
# CSRF_COOKIE_SAMESITE=Lax
# SECURE_SSL_REDIRECT=true
# SECURE_CONTENT_TYPE_NOSNIFF=true
# X_FRAME_OPTIONS=DENY
#
# HSTS is never enabled implicitly: browsers remember it for a long time and a
# wrong value cannot be taken back quickly. Enable it only once HTTPS is known
# to work for every hostname served, and start with a short duration.
# SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# SECURE_HSTS_PRELOAD=false

# --------------------------------------------------------------------------
# Reverse proxy. Only enable these behind a proxy that OVERWRITES the header:
# if the application is reachable directly, any client could forge
# X-Forwarded-Proto and make Django treat plain HTTP as secure.
# --------------------------------------------------------------------------
# TRUST_X_FORWARDED_PROTO=false
# USE_X_FORWARDED_HOST=false

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
# DATABASE_ENGINE selects the database backend. "sqlite" is the default and
# requires no other variables below; production requires "postgresql".
# See docs/postgresql_preparation.md and docs/postgresql_production.md.

DATABASE_ENGINE=sqlite

# Optional, used only when DATABASE_ENGINE=sqlite. Points Django at a specific
# SQLite file instead of the default BASE_DIR/db.sqlite3; a relative value is
# resolved against BASE_DIR. Intended for exporting a migration bundle from a
# stopped *copy* of the database without swapping the working file.
# SQLITE_DB_PATH=transfer/db-copy.sqlite3

# Used only when DATABASE_ENGINE=postgresql. DB_NAME, DB_USER, and
# DB_PASSWORD are required in that mode; there is no fallback to SQLite.
DB_NAME=quality_ecosystem
DB_USER=quality_ecosystem
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
# 0 stays the recommended default under ASGI: a long-lived SSE stream must not
# pin a database connection for its whole lifetime. Persistent connections or
# a pooler are a decision for after a real load test.
DB_CONN_MAX_AGE=0
DB_CONN_HEALTH_CHECKS=false

# PostgreSQL runtime parameters, applied through DATABASES OPTIONS. Never sent
# to SQLite. disable/allow/prefer still permit an unencrypted connection and
# are reported as a warning in production; use require or higher over a network.
DB_SSLMODE=prefer
DB_APPLICATION_NAME=quality-ecosystem
# Milliseconds; 0 disables a timeout and is reported as a warning. Without them
# one runaway query or a forgotten open transaction holds locks indefinitely.
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=10000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# --------------------------------------------------------------------------
# Static and media
# --------------------------------------------------------------------------
# STATIC_ROOT is PUBLIC: collectstatic gathers CSS/JS/images here for the web
# server. MEDIA_ROOT holds act attachments and is PROTECTED: it is served only
# through a permission-checked Django view and must never be published
# directly. They must be different directories.
# STATIC_ROOT_PATH=staticfiles
# MEDIA_ROOT_PATH=media

# --------------------------------------------------------------------------
# Operational flags
# --------------------------------------------------------------------------
# Destructive "delete every act" demo action. When false the URL is not even
# registered. Production forces it off and reports any attempt to enable it.
ENABLE_DEMO_RESET=false

# An administrative acknowledgement, NOT evidence that backups exist. It never
# replaces a real restore test — see docs/backup_restore.md.
BACKUP_POLICY_ACKNOWLEDGED=false

# Set only when Redis genuinely sits on a closed internal network, so a plain
# redis:// URL is an informed decision rather than an oversight.
# REDIS_NETWORK_IS_TRUSTED=false

# --------------------------------------------------------------------------
# Logging. Console is the primary handler: the process manager or the OS
# collects and rotates it. Secrets, tokens and business text are never logged.
# --------------------------------------------------------------------------
LOG_LEVEL=INFO
# LOG_TO_FILE=false
# LOG_FILE_PATH=logs/application.log
# LOG_FILE_MAX_BYTES=10485760
# LOG_FILE_BACKUP_COUNT=5

# --------------------------------------------------------------------------
# Email notifications. Disabled by default: with EMAIL_NOTIFICATIONS_ENABLED=
# false none of the SMTP variables below are required and no SMTP connection
# is ever attempted by the checks or the readiness commands.
# --------------------------------------------------------------------------
EMAIL_NOTIFICATIONS_ENABLED=false
# Must not be the console backend once notifications are enabled.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Required when notifications are enabled: SMTP/Exchange relay host and a port
# in the range 1-65535 (typically 25, 465 or 587).
# EMAIL_HOST=smtp.example.internal
# EMAIL_PORT=587
# Exactly one of these, never both.
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_HOST_USER and EMAIL_HOST_PASSWORD may stay empty: a corporate relay
# reachable only by an IP allow-list needs no application-level credentials.
# Whether authentication is required is an IT decision — see
# docs/deployment_preparation.md.
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# Required, approved sender address once notifications are enabled.
# DEFAULT_FROM_EMAIL=quality-ecosystem@example.internal
# All of the following must be positive once notifications are enabled.
# EMAIL_TIMEOUT=10
# EMAIL_NOTIFICATION_MAX_ATTEMPTS=3
# EMAIL_NOTIFICATION_RETRY_DELAY_SECONDS=300
# EMAIL_NOTIFICATION_BATCH_SIZE=100
# EMAIL_NOTIFICATION_PROCESSING_TIMEOUT_SECONDS=900

# Real-time events. Disabled by default: with REALTIME_ENABLED=false the
# project needs no Redis at all, the Noop publisher sends nothing, and
# `manage.py check` and an ordinary run work exactly as before.
REALTIME_ENABLED=false
# Select the Redis transport by pointing this at RedisRealtimePublisher:
# REALTIME_PUBLISHER_BACKEND=realtime.backends.RedisRealtimePublisher
REALTIME_PUBLISHER_BACKEND=realtime.backends.NoopRealtimePublisher
REALTIME_FAIL_SILENTLY=true
REALTIME_LOG_LEVEL=INFO

# Redis transport (RT-2). The demo URL below is a local server without
# authentication — never put a real password in this file, which is a template
# committed to Git. Supply credentials through the deployment environment, in
# the form redis://<user>:<password>@<host>:<port>/<db>.
REALTIME_REDIS_URL=redis://127.0.0.1:6379/0
REALTIME_CHANNEL_PREFIX=quality-ecosystem:realtime
# Deliberately short: publication runs inside the user's own request, so an
# unreachable Redis must cost that request ~1 second, not 5. Raise them here
# only if the real network between the app and Redis needs it.
REALTIME_REDIS_CONNECT_TIMEOUT_SECONDS=1
REALTIME_REDIS_SOCKET_TIMEOUT_SECONDS=1
# A pipelined publish slower than this is logged as realtime.slow_publish with
# the event type, channel count and duration only, milliseconds.
REALTIME_REDIS_SLOW_PUBLISH_MS=250
# Silence after which the SSE stream emits a keep-alive comment, seconds.
REALTIME_HEARTBEAT_SECONDS=25
# Reconnect delay advertised to the client, milliseconds.
REALTIME_RECONNECT_DELAY_MS=3000
# Hard ceiling for one serialized event, bytes.
REALTIME_MAX_EVENT_BYTES=16384

# Recovery and multi-tab behaviour (RT-5). Only these plain numbers reach the
# browser — nothing about Redis ever does.
# Silence after which the client declares itself degraded and starts polling
# /realtime/sync/, seconds.
REALTIME_DEGRADED_AFTER_SECONDS=20
# Fallback poll interval for a visible tab and for a hidden one, seconds.
REALTIME_SYNC_POLL_SECONDS=30
REALTIME_SYNC_HIDDEN_POLL_SECONDS=90
# A stream closes itself after this long so the next connection re-authenticates
# and re-checks permissions. Must exceed REALTIME_HEARTBEAT_SECONDS.
REALTIME_MAX_CONNECTION_SECONDS=900
# Leader-tab lease: how long it is valid and how often the leader renews it.
REALTIME_LEADER_LEASE_SECONDS=12
REALTIME_LEADER_HEARTBEAT_SECONDS=4
# STAB-1: how often a live leader tab re-runs /realtime/sync/ as a safety net
# against a Redis event that was published but never delivered, seconds.
# Deliberately rare — not a polling replacement, allowed range 60-1800.
REALTIME_LIVE_SYNC_SECONDS=300
